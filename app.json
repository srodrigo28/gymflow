{
  "expo": {
    "name": "Gyn Flow",
    "slug": "gym-flow",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "gymflow",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.sebsolucoes.gynflow"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#151A23",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.sebsolucoes.gynflow"
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png",
      "lang": "pt-BR",
      "themeColor": "#151A23"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#151A23",
          "dark": {
            "backgroundColor": "#151A23"
          }
        }
      ],
      "expo-secure-store",
      "expo-asset",
      "expo-font",
      "expo-sqlite",
      [
        "expo-image-picker",
        {
          "cameraPermission": "O Gyn Flow usa a câmera para você tirar a foto de evolução do mês.",
          "photosPermission": "O Gyn Flow acessa suas fotos para você escolher a imagem de evolução do mês."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "O Gyn Flow usa a câmera para tirar a foto de evolução do mês com o guia de contorno."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "O Gyn Flow usa sua localização só na hora do check-in na academia."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/android-icon-monochrome.png"
        }
      ]
    ],
    "extra": {
      "apiUrl": "https://99dev.pro/gymflow-api"
    },
    "experiments": {
      "typedRoutes": true
    }
  }
}
