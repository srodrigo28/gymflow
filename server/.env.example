# Copie para .env e ajuste. O .env não vai para o git.

# Postgres. Em desenvolvimento, `npx prisma dev --name gynflow --detach` sobe um banco local
# sem Docker e mostra a URL TCP. O parâmetro `schema` escolhe o schema do Postgres.
DATABASE_URL="postgres://postgres:postgres@localhost:51214/template1?sslmode=disable&schema=public"

# Porta do servidor.
PORT=3333

# Endereço público do servidor. Vira a base dos links de convite enviados pelo WhatsApp.
PUBLIC_URL=http://localhost:3333

# Link que abre o app na tela de convite. Em produção, o esquema do app (gymflow://).
# Com o Expo Go, use exp://<ip-do-computador>:<porta-do-metro>/--/
APP_LINK_BASE=gymflow://

# E-mails que viram administradores ao entrar (separados por vírgula). Administrador vê
# o painel com o total de usuários, que é o gatilho dos 200.
ADMIN_EMAILS=

# Origens liberadas para o app web, separadas por vírgula (ex.: http://localhost:8081).
CORS_ORIGINS=

# true quando o servidor fica atrás de um proxy (Render, Railway, Fly): o IP do cliente
# passa a vir do cabeçalho X-Forwarded-For, que o limite de tentativas usa.
TRUST_PROXY=false
