// Banco do Gyn Flow. Datas sempre em timestamptz: o placar dos desafios conta dias no
// fuso de cada desafio, e isso só é confiável com o instante gravado com fuso.

generator client {
  provider            = "prisma-client"
  output              = "../generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String   @map("password_hash")
  role         Role     @default(USER)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  // Atualizado no máximo uma vez por hora; é o que mede "ativos na semana".
  lastSeenAt   DateTime @default(now()) @map("last_seen_at") @db.Timestamptz(3)

  sessions         AuthSession[]
  workouts         Workout[]
  ownedChallenges  Challenge[]       @relation("ChallengeOwner")
  memberships      ChallengeMember[]

  @@map("users")
}

// Sessão de login. O token só existe no aparelho; aqui fica o hash dele.
model AuthSession {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  tokenHash String   @unique @map("token_hash")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("auth_sessions")
}

// Treinos que o app sobe da fila de sincronização. Os ids vêm do aparelho.
model Workout {
  id              String    @id
  userId          String    @map("user_id")
  startedAt       DateTime  @map("started_at") @db.Timestamptz(3)
  finishedAt      DateTime? @map("finished_at") @db.Timestamptz(3)
  note            String?
  // Quando o treino mudou no aparelho: a versão mais nova vence.
  clientUpdatedAt DateTime  @map("client_updated_at") @db.Timestamptz(3)
  deletedAt       DateTime? @map("deleted_at") @db.Timestamptz(3)
  syncedAt        DateTime  @updatedAt @map("synced_at") @db.Timestamptz(3)

  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  exercises WorkoutExercise[]

  @@index([userId, startedAt])
  @@map("workouts")
}

// O exercício vem com nome, grupo e tipo junto: o servidor não depende do catálogo do app.
model WorkoutExercise {
  id         String @id
  workoutId  String @map("workout_id")
  exerciseId String @map("exercise_id")
  name       String
  muscle     String
  kind       String
  position   Int

  workout Workout      @relation(fields: [workoutId], references: [id], onDelete: Cascade)
  sets    WorkoutSet[]

  @@index([workoutId])
  @@map("workout_exercises")
}

model WorkoutSet {
  id                String   @id
  workoutExerciseId String   @map("workout_exercise_id")
  position          Int
  weightKg          Float?   @map("weight_kg")
  reps              Int?
  durationSec       Int?     @map("duration_sec")
  distanceM         Float?   @map("distance_m")
  rpe               Int?
  done              Boolean
  isPr              Boolean  @map("is_pr")
  createdAt         DateTime @map("created_at") @db.Timestamptz(3)

  exercise WorkoutExercise @relation(fields: [workoutExerciseId], references: [id], onDelete: Cascade)

  @@index([workoutExerciseId])
  @@map("workout_sets")
}

// Desafio entre amigos: cada dia com treino concluído vale um ponto, no fuso do desafio.
model Challenge {
  id         String   @id @default(uuid())
  // Quem criou pode sair do app sem apagar o desafio dos outros.
  ownerId    String?  @map("owner_id")
  name       String
  startsAt   DateTime @map("starts_at") @db.Timestamptz(3)
  endsAt     DateTime @map("ends_at") @db.Timestamptz(3)
  timezone   String   @default("America/Sao_Paulo")
  inviteCode String   @unique @map("invite_code")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  owner   User?             @relation("ChallengeOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  members ChallengeMember[]

  @@map("challenges")
}

model ChallengeMember {
  challengeId String   @map("challenge_id")
  userId      String   @map("user_id")
  joinedAt    DateTime @default(now()) @map("joined_at") @db.Timestamptz(3)

  challenge Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([challengeId, userId])
  @@index([userId])
  @@map("challenge_members")
}
