server {
    listen ${PORT};
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    include /etc/nginx/snippets/cross-origin.conf;

    # Arquivos com hash no nome (o app, o worker do banco e os assets): podem ficar em cache para sempre.
    location /_expo/ {
        include /etc/nginx/snippets/cross-origin.conf;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        try_files $uri =404;
    }

    location /assets/ {
        include /etc/nginx/snippets/cross-origin.conf;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        try_files $uri =404;
    }

    # A página muda a cada build: sempre conferir.
    location = /index.html {
        include /etc/nginx/snippets/cross-origin.conf;
        add_header Cache-Control "no-cache" always;
    }

    # As rotas do app (/treino, /liga...) não são arquivos: devolvem o index.html.
    location / {
        include /etc/nginx/snippets/cross-origin.conf;
        add_header Cache-Control "no-cache" always;
        try_files $uri $uri/ /index.html;
    }

    location = /healthz {
        include /etc/nginx/snippets/cross-origin.conf;
        default_type text/plain;
        return 200 "ok";
    }
}
